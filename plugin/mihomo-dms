#!/bin/sh
# Bundled, deliberately restricted bridge between the DMS widget and Mihomo.
set -eu

api='http://127.0.0.1:9090'
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/mihomo-dms"
history_file="$state_dir/delay-history.json"
mode_file="$state_dir/previous-mode"

encoded_name() {
  jq -rn --arg value "$1" '$value | @uri'
}

api_get() {
  curl --noproxy '*' -fsS --max-time 3 "$api$1"
}

read_mode() {
  config=$(api_get /configs) || return 1
  printf '%s' "$config" | jq -er '
    .mode | ascii_downcase | select(. == "direct" or . == "rule" or . == "global")'
}

read_tun() {
  config=$(api_get /configs) || return 1
  printf '%s' "$config" | jq -e '.tun.enable == true' >/dev/null
}

service_unit=mihomo.service

service_exists() {
  systemctl --user cat "$service_unit" >/dev/null 2>&1 ||
    systemctl cat "$service_unit" >/dev/null 2>&1
}

service_scope() {
  if systemctl --user cat "$service_unit" >/dev/null 2>&1; then
    printf '%s' user
  elif systemctl cat "$service_unit" >/dev/null 2>&1; then
    printf '%s' system
  else
    printf '%s' user
  fi
}

service_control() {
  action=$1
  case "$(service_scope)" in
    system) systemctl "$action" "$service_unit" ;;
    *) systemctl --user "$action" "$service_unit" ;;
  esac
}

service_running() {
  systemctl --user is-active --quiet "$service_unit" 2>/dev/null && return 0
  systemctl is-active --quiet "$service_unit" 2>/dev/null && return 0
  curl --noproxy '*' -fsS --max-time 1 "$api/version" >/dev/null 2>&1
}

wait_api() {
  attempt=0
  while [ "$attempt" -lt 100 ]; do
    if curl --noproxy '*' -fsS --max-time 1 "$api/version" >/dev/null 2>&1; then
      return 0
    fi
    attempt=$((attempt + 1))
    sleep 0.1
  done
  return 1
}

miho_bin() {
  if [ -n "${MIHO_BIN:-}" ] && [ -x "${MIHO_BIN}" ]; then
    printf '%s' "$MIHO_BIN"
    return 0
  fi
  if command -v miho >/dev/null 2>&1; then
    command -v miho
    return 0
  fi
  for candidate in "$HOME/bin/others/miho" "$HOME/.local/bin/miho" "$HOME/bin/miho"; do
    if [ -x "$candidate" ]; then
      printf '%s' "$candidate"
      return 0
    fi
  done
  return 1
}

api_down() {
  curl --noproxy '*' -fsS --max-time 1 "$api/version" >/dev/null 2>&1 && return 1
  return 0
}

wait_api_down() {
  attempt=0
  while [ "$attempt" -lt 100 ]; do
    api_down && return 0
    attempt=$((attempt + 1))
    sleep 0.1
  done
  return 1
}

# DMS registers a polkit agent, so pkexec can ask for the password. The root
# shell only runs the fixed miho action and hands the user's files back; a
# user-writable helper cannot change ownership on its own.
pkexec_miho() {
  pkexec /bin/sh -c '
uid=${PKEXEC_UID:?}
entry=$(getent passwd "$uid") || exit 1
home=$(printf "%s" "$entry" | cut -d: -f6)
gid=$(printf "%s" "$entry" | cut -d: -f4)
[ -n "$home" ] || exit 1
HOME="$home" "$@" >/dev/null 2>&1
status=$?
for dir in "$home/.config/mihomo" "$home/.config/miho"; do
  [ -d "$dir" ] || continue
  [ "$(stat -c %u "$dir" 2>/dev/null)" = "$uid" ] || chown -R "$uid:$gid" "$dir"
done
exit "$status"' sh "$@"
}

service_start() {
  if service_exists; then
    if ! service_control start; then
      printf '%s\n' '{"ok":false,"error":"systemctl could not start mihomo.service."}'
      return 1
    fi
  elif miho=$(miho_bin); then
    if ! "$miho" start >/dev/null 2>&1; then
      printf '%s\n' '{"ok":false,"error":"miho could not start Mihomo. Check ~/.config/miho/mihomo.log."}'
      return 1
    fi
  else
    printf '%s\n' '{"ok":false,"error":"No mihomo.service unit and no miho helper were found."}'
    return 1
  fi
  if ! wait_api; then
    printf '%s\n' '{"ok":false,"error":"Mihomo started but its API did not answer. Check journalctl --user -u mihomo.service."}'
    return 1
  fi
  printf '%s\n' '{"ok":true,"available":true,"serviceRunning":true}'
}

service_stop() {
  if systemctl --user is-active --quiet "$service_unit" 2>/dev/null; then
    systemctl --user stop "$service_unit" || {
      printf '%s\n' '{"ok":false,"error":"systemctl could not stop mihomo.service."}'
      return 1
    }
  elif systemctl is-active --quiet "$service_unit" 2>/dev/null; then
    systemctl stop "$service_unit" || {
      printf '%s\n' '{"ok":false,"error":"systemctl could not stop mihomo.service."}'
      return 1
    }
  elif miho=$(miho_bin); then
    # TUN mode and miho's own restarts leave mihomo outside systemd.
    if read_tun 2>/dev/null; then
      pkexec_miho "$miho" stop || {
        printf '%s\n' '{"ok":false,"error":"Stopping the TUN daemon needs administrator authentication."}'
        return 1
      }
    elif ! "$miho" stop >/dev/null 2>&1; then
      printf '%s\n' '{"ok":false,"error":"miho could not stop Mihomo."}'
      return 1
    fi
  fi
  if ! wait_api_down; then
    printf '%s\n' '{"ok":false,"error":"Mihomo is still running after a stop request."}'
    return 1
  fi
  printf '%s\n' '{"ok":true,"available":false,"active":false,"serviceRunning":false}'
}

tun_on() {
  miho=$(miho_bin) || {
    printf '%s\n' '{"ok":false,"error":"The miho helper is required for TUN mode and was not found."}'
    return 1
  }
  if ! pkexec_miho "$miho" tun on; then
    printf '%s\n' '{"ok":false,"error":"TUN mode needs administrator authentication (cancelled or failed)."}'
    return 1
  fi
  if ! wait_api || ! read_tun; then
    printf '%s\n' '{"ok":false,"error":"Mihomo restarted but TUN did not activate. Check ~/.config/miho/mihomo.log."}'
    return 1
  fi
  printf '%s\n' '{"ok":true,"available":true,"serviceRunning":true,"tunEnabled":true}'
}

tun_off() {
  miho=$(miho_bin) || {
    printf '%s\n' '{"ok":false,"error":"The miho helper is required to stop a TUN daemon and was not found."}'
    return 1
  }
  # A TUN daemon runs as root; stopping it needs the same polkit prompt.
  if read_tun 2>/dev/null; then
    pkexec_miho "$miho" stop || {
      printf '%s\n' '{"ok":false,"error":"Disabling TUN mode needs administrator authentication."}'
      return 1
    }
  else
    "$miho" stop >/dev/null 2>&1 || true
  fi
  # miho leaves a user-mode daemon behind in TUN off, so let the systemd unit
  # own proxy mode again when one exists.
  if service_exists; then
    service_control start || {
      printf '%s\n' '{"ok":false,"error":"systemctl could not start mihomo.service after TUN was disabled."}'
      return 1
    }
  elif ! "$miho" start >/dev/null 2>&1; then
    printf '%s\n' '{"ok":false,"error":"miho could not restart Mihomo in proxy mode."}'
    return 1
  fi
  if ! wait_api; then
    printf '%s\n' '{"ok":false,"error":"Mihomo did not restart in proxy mode."}'
    return 1
  fi
  if read_tun; then
    printf '%s\n' '{"ok":false,"error":"TUN is still enabled after the stop request."}'
    return 1
  fi
  printf '%s\n' '{"ok":true,"available":true,"serviceRunning":true,"tunEnabled":false}'
}

http_providers() {
  provider_data=$(api_get /providers/proxies) || return 1
  printf '%s' "$provider_data" | jq -ce '
    if (.providers | type) != "object" then error("Invalid provider response")
    else .providers | to_entries | map(select(.value.vehicleType == "HTTP") | .key) end'
}

update_provider() {
  name=${1:?provider is required}
  if ! providers=$(http_providers); then
    printf '%s\n' '{"ok":false,"error":"Could not read HTTP providers from Mihomo."}'
    return 1
  fi
  if ! printf '%s' "$providers" | jq -e --arg name "$name" 'index($name) != null' >/dev/null; then
    printf '%s\n' '{"ok":false,"error":"The HTTP provider is no longer available."}'
    return 2
  fi
  provider_path=$(encoded_name "$name")
  # Discard upstream bodies: Mihomo errors can contain subscription URLs or
  # credentials. Return only a safe HTTP status and fixed English messages.
  if http_code=$(curl --noproxy '*' -sS --max-time 60 -o /dev/null -w '%{http_code}' \
      -X PUT "$api/providers/proxies/$provider_path" 2>/dev/null); then
    case "$http_code" in
      2[0-9][0-9])
        printf '%s\n' '{"ok":true}'
        return
        ;;
    esac
    jq -n --arg code "$http_code" '{ok:false, error:("Mihomo could not update this provider (HTTP " + $code + ").")}'
  else
    printf '%s\n' '{"ok":false,"error":"The provider update timed out or Mihomo could not be reached."}'
  fi
  return 1
}

groups_json() {
  printf '%s\n' "$@" | jq -Rsc 'split("\n") | map(select(length > 0))'
}

status() {
  selected_groups=$(groups_json "$@")
  running=false
  if service_running; then
    running=true
  fi

  if ! config=$(api_get /configs); then
    jq -n --argjson running "$running" \
      '{available:false, active:false, mode:"direct", serviceRunning:$running,
        tunEnabled:false, httpProviders:[], groups:[], stats:[]}'
    return 0
  fi

  if ! mode=$(printf '%s' "$config" | jq -er '
      .mode | ascii_downcase | select(. == "direct" or . == "rule" or . == "global")' 2>/dev/null); then
    jq -n --argjson running "$running" \
      '{available:false, active:false, mode:"direct", serviceRunning:$running,
        tunEnabled:false, error:"Mihomo returned an invalid controller state.",
        httpProviders:[], groups:[], stats:[]}'
    return 1
  fi

  tun=false
  if printf '%s' "$config" | jq -e '.tun.enable == true' >/dev/null 2>&1; then
    tun=true
  fi

  proxies=$(api_get /proxies)
  # Provider discovery is optional; it must not break node controls.
  providers=$(http_providers 2>/dev/null || printf '%s' '[]')
  history=$(cat "$history_file" 2>/dev/null || printf '%s' '{}')
  printf '%s' "$proxies" | jq --arg mode "$mode" --argjson tun "$tun" --argjson providers "$providers" --argjson history "$history" --argjson groups "$selected_groups" '
    .proxies as $p |
    ($groups | map(select($p[.].type == "Selector"))) as $selectorGroups |
    def choices($group): $p[$group].all // [];
    def resolved($name):
      if $name == "" then ""
      elif ($p[$name].now // "") != "" then $p[$name].now
      else $name
      end;
    def stat($name):
      (resolved($name)) as $display |
      {name: $name, displayName: $display, history: ($history[$display] // $history[$name] // [])};
    {
      available: true,
      active: ($mode != "direct"),
      mode: $mode,
      serviceRunning: true,
      tunEnabled: $tun,
      httpProviders: $providers,
      groups: [
        $selectorGroups[] as $group |
        ($p[$group].now // "") as $current |
        {
          name: $group,
          type: ($p[$group].type // ""),
          current: $current,
          shownCurrent: resolved($current),
          choices: choices($group)
        }
      ],
      stats: ([
        $selectorGroups[] as $group |
        choices($group)[] |
        stat(.)
      ] | unique_by(.name))
    }'
}

set_vpn() {
  case "${1:-}" in
    on|off) ;;
    *) printf '%s\n' '{"ok":false,"error":"State must be on or off"}'; return 2 ;;
  esac
  if ! mode=$(read_mode 2>/dev/null); then
    printf '%s\n' '{"ok":false,"available":false,"error":"Mihomo API is unavailable or returned an invalid mode."}'
    return 1
  fi
  target=$mode
  if [ "$1" = off ]; then
    target=direct
    if [ "$mode" != direct ]; then
      # Remember only the last enabled mode, never DIRECT. This is user state,
      # not Mihomo's system config, and repeated OFF must preserve it.
      if ! save_mode "$mode"; then
        printf '%s\n' '{"ok":false,"error":"Could not remember the previous VPN mode. No mode change was requested."}'
        return 1
      fi
    fi
  elif [ "$mode" = direct ]; then
    target=$(cat "$mode_file" 2>/dev/null || true)
    case "$target" in rule|global) ;; *) target=rule ;; esac
  fi
  if [ "$target" != "$mode" ]; then
    payload=$(jq -nc --arg mode "$target" '{mode:$mode}')
    # Never expose controller response bodies (which can contain secrets).
    if ! curl --noproxy '*' -fsS --max-time 5 -o /dev/null -X PATCH \
        -H 'Content-Type: application/json' --data "$payload" "$api/configs" 2>/dev/null; then
      printf '%s\n' '{"ok":false,"error":"Could not change VPN mode through Mihomo. Refresh status and try again."}'
      return 1
    fi
    if ! mode=$(read_mode 2>/dev/null); then
      printf '%s\n' '{"ok":false,"available":false,"error":"Mihomo did not confirm the VPN mode. Its API is unavailable or returned an invalid mode."}'
      return 1
    fi
    if [ "$mode" != "$target" ]; then
      printf '%s\n' '{"ok":false,"error":"Mihomo did not confirm the requested VPN mode. Refresh status and try again."}'
      return 1
    fi
  fi
  jq -n --arg mode "$mode" '{ok:true, available:true, active:($mode != "direct"), mode:$mode}'
}

save_mode() {
  mkdir -p "$state_dir" || return 1
  mode_temp=$(mktemp "$state_dir/previous-mode.XXXXXX") || return 1
  if printf '%s\n' "$1" > "$mode_temp" && mv -f "$mode_temp" "$mode_file"; then
    return 0
  else
    rm -f "$mode_temp"
    return 1
  fi
}

select_proxy() {
  group=${1:?group is required}
  target=${2:?target is required}
  proxies=$(api_get /proxies)
  if ! printf '%s' "$proxies" | jq -e --arg group "$group" --arg target "$target" \
      '.proxies[$group].all | index($target) != null' >/dev/null; then
    printf '%s\n' '{"ok":false,"error":"Proxy is not available in this group"}'
    return 2
  fi

  group_path=$(encoded_name "$group")
  payload=$(jq -n --arg name "$target" '{name: $name}')
  curl --noproxy '*' -fsS --max-time 5 -X PUT -H 'Content-Type: application/json' \
    --data "$payload" "$api/proxies/$group_path" >/dev/null
  jq -n --arg group "$group" --arg target "$target" '{ok:true, group:$group, target:$target}'
}

delay() {
  group=${1:?group is required}
  group_path=$(encoded_name "$group")
  response=$(curl --noproxy '*' -fsS --max-time 8 -G \
    --data-urlencode 'url=https://www.gstatic.com/generate_204' \
    --data-urlencode 'timeout=5000' \
    "$api/proxies/$group_path/delay" 2>/dev/null || true)
  value=$(printf '%s' "$response" | jq -r '.delay // -1' 2>/dev/null || printf '%s' -1)
  case "$value" in ''|*[!0-9-]*) value=-1 ;; esac
  jq -n --arg group "$group" --argjson delay "$value" '{group:$group, delay:$delay}'
}

probe_one() {
  name=$1
  provider=${2:-}
  name_path=$(encoded_name "$name")
  if [ -n "$provider" ]; then
    provider_path=$(encoded_name "$provider")
    endpoint="$api/providers/proxies/$provider_path/$name_path/healthcheck"
  else
    endpoint="$api/proxies/$name_path/delay"
  fi
  response=$(curl --noproxy '*' -fsS --max-time 8 -G \
    --data-urlencode 'url=https://www.gstatic.com/generate_204' \
    --data-urlencode 'timeout=5000' \
    "$endpoint" 2>/dev/null || true)
  value=$(printf '%s' "$response" | jq -r '.delay // -1' 2>/dev/null || printf '%s' -1)
  case "$value" in ''|*[!0-9-]*) value=-1 ;; esac
  jq -n --arg name "$name" --argjson delay "$value" '{name:$name, delay:$delay}'
}

ping_all() {
  selected_groups=$(groups_json "$@")
  proxies=$(api_get /proxies)
  provider_data=$(api_get /providers/proxies 2>/dev/null || printf '%s' '{"providers":{}}')
  probe_records=$(printf '%s' "$proxies" | jq -r --argjson groups "$selected_groups" --argjson providerData "$provider_data" '
    .proxies as $p |
    def provider_for($name):
      ([($providerData.providers // {}) | to_entries[] |
        select(.value.vehicleType != "Compatible") |
        select((.value.proxies // [] | map(.name) | index($name)) != null) |
        .key][0] // "");
    def leaves($name; $seen):
      if ($seen | index($name)) != null then empty
      elif (($p[$name].all // []) | length) > 0 then
        $p[$name].all[] | leaves(.; $seen + [$name])
      else $name
      end;
    [$groups[] as $group |
      if $p[$group].type == "Selector" then leaves($group; []) else empty end
    ] | unique[] as $name |
    [$name, provider_for($name)] | @tsv')
  temp_dir=$(mktemp -d "${TMPDIR:-/tmp}/mihomo-dms.XXXXXX")
  trap 'rm -rf "$temp_dir"' EXIT HUP INT TERM
  batch=0
  sequence=0
  tab=$(printf '\t')
  while IFS="$tab" read -r name provider; do
    [ -n "$name" ] || continue
    sequence=$((sequence + 1))
    (probe_one "$name" "$provider" > "$temp_dir/$sequence.json") &
    batch=$((batch + 1))
    if [ "$batch" -ge 6 ]; then
      wait
      batch=0
    fi
  done <<EOF
$probe_records
EOF
  wait
  if [ "$sequence" -eq 0 ]; then
    printf '%s\n' '{"ok":true,"results":[]}'
    return
  fi
  results=$(jq -s '.' "$temp_dir"/*.json)
  mkdir -p "$state_dir"
  old=$(cat "$history_file" 2>/dev/null || printf '%s' '{}')
  now=$(date +%s)
  updated=$(jq -n --argjson old "$old" --argjson results "$results" --argjson now "$now" '
    reduce $results[] as $result ($old;
      .[$result.name] = ((.[$result.name] // []) + [{at:$now, delay:$result.delay}] | .[-8:])
    )')
  printf '%s\n' "$updated" > "$history_file"
  jq -n --argjson results "$results" '{ok:true, results:$results}'
}

groups() {
  api_get /proxies | jq '
    .proxies | to_entries |
    map(select(.value.type == "Selector")) |
    map({name: .key, type: .value.type})'
}

action=${1:-status}
if [ "$#" -gt 0 ]; then
  shift
fi

case $action in
  update-provider) update_provider "${1:-}" ;;
  status) status "$@" ;;
  set-vpn) set_vpn "${1:-}" ;;
  service-start) service_start ;;
  service-stop) service_stop ;;
  tun-on) tun_on ;;
  tun-off) tun_off ;;
  select) select_proxy "${1:-}" "${2:-}" ;;
  delay) delay "${1:-}" ;;
  ping-all) ping_all "$@" ;;
  groups) groups ;;
  *) printf '%s\n' '{"ok":false,"error":"Unknown action"}'; exit 2 ;;
esac
