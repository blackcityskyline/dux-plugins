#!/bin/sh
set -eu

method=GET
payload=
url=
while [ "$#" -gt 0 ]; do
    case "$1" in
        -X)
            method=$2
            shift 2
            ;;
        --data)
            payload=$2
            shift 2
            ;;
        --max-time|-H|--data-urlencode)
            shift 2
            ;;
        -* )
            shift
            ;;
        *)
            url=$1
            shift
            ;;
    esac
done

case "$method:$url" in
    GET:*/configs)
        mode=$(cat "$MIHOMO_TEST_MODE_FILE")
        jq -n --arg mode "$mode" '{mode:$mode}'
        ;;
    PATCH:*/configs)
        printf '%s' "$payload" | jq -r '.mode' > "$MIHOMO_TEST_MODE_FILE"
        ;;
    GET:*/proxies)
        printf '%s\n' '{"proxies":{}}'
        ;;
    *)
        printf 'Unexpected mock curl request: %s %s\n' "$method" "$url" >&2
        exit 2
        ;;
esac
