[Unit]
Description=Validated Capybara subscription updater for Mihomo
After=network-online.target

[Service]
ExecStart=%h/.local/bin/capybara-updater serve
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true

[Install]
WantedBy=default.target
